{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "apinex": {
      "name": "APInex — modelos gratuitos disponíveis",
      "env": ["APINEX_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://apinex.bond/v1"
      },
      "models": {
        "free/muse-spark-1.3": { "name": "Muse Spark 1.3" },
        "free/deepseek-v4.1-flash": { "name": "DeepSeek V4.1 Flash" },
        "free/glm-5.3": { "name": "GLM 5.3" },
        "free/glm-5.3-flash": { "name": "GLM 5.3 Flash" },
        "free/minimax-m3.1-flash": { "name": "MiniMax M3.1 Flash" },
        "free/glm-5.3-flashx": { "name": "GLM 5.3 FlashX" },
        "free/gemini-3.8-flash": { "name": "Gemini 3.8 Flash" },
        "free/deepseek-v4-pro-0813": { "name": "DeepSeek V4 Pro" },
        "free/gpt-6-luna": { "name": "GPT 6 Luna" },
        "free/mimo-v2.6-pro": { "name": "Mimo V2.6 Pro" },
        "free/jev-1.13": { "name": "Jev 1.13" }
      }
    }
  },
  "policies": [
    { "effect": "deny", "action": "provider.use", "resource": "*" },
    { "effect": "allow", "action": "provider.use", "resource": "apinex" }
  ]
}
